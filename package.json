{
  "name": "patrickadas-backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prisma:generate": "node ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prebuild": "npm run prisma:generate",
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "test": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@casl/ability": "6.8.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "6.19.3",
    "@sentry/node": "11.12.0",
    "@supabase/supabase-js": "^2.49.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "nestjs-zod": "4.3.1",
    "pino": "10.4.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/node": "24.19.2",
    "jest": "^30.5.2",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "^5.4.5"
  }
}
