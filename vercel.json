{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node",
      "config": {
        "installCommand": ["npm", "ci"],
        "buildCommand": ["npm", "run", "build"],
        "outputDirectory": "dist"
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/dist/main.js" }]
}